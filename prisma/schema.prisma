generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AccountType {
  INSTITUTIONAL
  INDIVIDUAL
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum Role {
  SUPERADMIN
  SOSTENEDOR
  DIRECTOR
  UTP
  DOCENTE
}
enum Track {
  PARVULARIA
  BASICA
  HC
  TP
}
enum PlanningStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}
enum AssessmentType {
  DIAGNOSTIC
  FORMATIVE
  SUMMATIVE
}
enum OfferingSource {
  MINEDUC
  INSTITUTIONAL
}

model Organization {
  id String @id @default(cuid())
  name String
  rut String?
  active Boolean @default(true)
  schools School[]
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model School {
  id String @id @default(cuid())
  name String
  rbd String?
  commune String?
  region String?
  active Boolean @default(true)
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  years AcademicYear[]
  users User[]
  courses Course[]
  @@index([organizationId])
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  role Role
  accountType AccountType @default(INSTITUTIONAL)
  subscriptionStatus SubscriptionStatus?
  trialEndsAt DateTime?
  subscriptionEndsAt DateTime?
  monthlyPriceClp Int?
  monthlyAiLimit Int?
  monthlyAiUsed Int @default(0)
  aiUsageResetAt DateTime?
  active Boolean @default(true)
  passwordHash String?
  organizationId String
  schoolId String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  school School? @relation(fields:[schoolId],references:[id])
  plannings Planning[]
  assessments Assessment[]
  supportMaterials SupportMaterial[]
  teachingAssignments TeachingAssignment[]
  hcTeachingAssignments HCTeachingAssignment[]
  subscriptionPayments SubscriptionPayment[]
}
model AcademicYear {
  id String @id @default(cuid())
  year Int
  jec Boolean?
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  courses Course[]
  plannings Planning[]
  assessments Assessment[]
  supportMaterials SupportMaterial[]
  hcOfferings HCCurricularOffering[]
  @@unique([schoolId,year])
}
model Course {
  id String @id @default(cuid())
  name String
  level String
  track Track
  schoolId String
  academicYearId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade)
  plannings Planning[]
  assessments Assessment[]
  supportMaterials SupportMaterial[]
  teachingAssignments TeachingAssignment[]
  hcTeachingAssignments HCTeachingAssignment[]
  @@index([schoolId,academicYearId])
}
model LearningObjective {
  id String @id @default(cuid())
  code String
  text String
  level String
  subject String?
  specialty String?
  module String?
  source String
  planningLinks PlanningObjective[]
  assessmentLinks AssessmentObjective[]
  moduleLinks CurriculumModuleObjective[]
  @@index([level,subject])
  @@index([specialty,module])
}
model Planning {
  id String @id @default(cuid())
  title String
  status PlanningStatus @default(DRAFT)
  track Track
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  objectives PlanningObjective[]
  implementation ImplementationRecord?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PlanningObjective {
  planningId String
  objectiveId String
  planning Planning @relation(fields:[planningId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id])
  @@id([planningId,objectiveId])
}
model ImplementationRecord {
  id String @id @default(cuid())
  planningId String @unique
  implementedAt DateTime
  evidence String?
  notes String?
  planning Planning @relation(fields:[planningId],references:[id],onDelete:Cascade)
}
model Assessment {
  id String @id @default(cuid())
  title String
  type AssessmentType
  track Track
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  objectives AssessmentObjective[]
  result AssessmentResult?
  createdAt DateTime @default(now())
}
model AssessmentObjective {
  assessmentId String
  objectiveId String
  assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id])
  @@id([assessmentId,objectiveId])
}
model AssessmentResult {
  id String @id @default(cuid())
  assessmentId String @unique
  achievement Float
  students Int?
  notes String?
  assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade)
}

model TeachingAssignment {
  id String @id @default(cuid())
  subject String
  courseId String
  teacherId String
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  teacher User @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([courseId,subject,teacherId])
  @@index([teacherId])
}

model HCCurricularOffering {
  id String @id @default(cuid())
  name String
  area String?
  level String
  source OfferingSource @default(MINEDUC)
  officialCode String?
  weeklyHours Int?
  active Boolean @default(true)
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  teachingAssignments HCTeachingAssignment[]
  @@unique([academicYearId,level,name])
  @@index([academicYearId,level,active])
}

model HCTeachingAssignment {
  id String @id @default(cuid())
  offeringId String
  courseId String
  teacherId String
  offering HCCurricularOffering @relation(fields:[offeringId],references:[id],onDelete:Cascade)
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  teacher User @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([offeringId,courseId,teacherId])
  @@index([courseId])
  @@index([teacherId])
}


model CurriculumModule {
  id String @id @default(cuid())
  code String?
  name String
  specialty String
  level String
  source String
  sourceUrl String?
  active Boolean @default(true)
  objectives CurriculumModuleObjective[]
  @@unique([specialty,level,name])
  @@index([specialty,level])
}

model CurriculumModuleObjective {
  moduleId String
  objectiveId String
  module CurriculumModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id],onDelete:Cascade)
  @@id([moduleId,objectiveId])
  @@index([objectiveId])
}

model SupportMaterial {
  id String @id @default(cuid())
  title String
  materialType String
  subject String?
  topic String
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([courseId])
}

model SubscriptionPayment {
  id String @id @default(cuid())
  commerceOrder String @unique
  flowToken String? @unique
  flowOrder Int?
  userId String
  amount Int
  status String @default("PENDING")
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}

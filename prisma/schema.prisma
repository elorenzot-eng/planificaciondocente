generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AccountType {
  INSTITUTIONAL
  INDIVIDUAL
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum Role {
  SUPERADMIN
  SOSTENEDOR
  DIRECTOR
  UTP
  DOCENTE
}
enum Track {
  PARVULARIA
  BASICA
  HC
  TP
}
enum PlanningStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}
enum AssessmentType {
  DIAGNOSTIC
  FORMATIVE
  SUMMATIVE
}
enum OfferingSource {
  MINEDUC
  INSTITUTIONAL
}

model Organization {
  id String @id @default(cuid())
  name String
  rut String?
  active Boolean @default(true)
  schools School[]
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model School {
  id String @id @default(cuid())
  name String
  rbd String?
  commune String?
  region String?
  active Boolean @default(true)
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  years AcademicYear[]
  users User[]
  institutionalLicenses InstitutionalExamLicense[]
  licensedStudents LicensedStudent[]
  academicExamResults AcademicExamResult[]
  courses Course[]
  @@index([organizationId])
}
model User {
  id String @id @default(cuid())
  email String @unique
  rut String? @unique
  name String
  role Role
  accountType AccountType @default(INSTITUTIONAL)
  subscriptionStatus SubscriptionStatus?
  trialEndsAt DateTime?
  subscriptionEndsAt DateTime?
  monthlyPriceClp Int?
  monthlyAiLimit Int?
  monthlyAiUsed Int @default(0)
  aiUsageResetAt DateTime?
  active Boolean @default(true)
  passwordHash String?
  organizationId String
  schoolId String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  school School? @relation(fields:[schoolId],references:[id])
  plannings Planning[]
  assessments Assessment[]
  learningResources LearningResource[]
  supportMaterials SupportMaterial[]
  portfolioDrafts PortfolioDraft[]
  portfolioReviews PortfolioReview[]
  teachingAssignments TeachingAssignment[]
  hcTeachingAssignments HCTeachingAssignment[]
  subscriptionPayments SubscriptionPayment[]
  passwordResetTokens PasswordResetToken[]
  agendaTasks AgendaTask[]
  subscriptionReminders SubscriptionReminder[]
  supportTickets SupportTicket[] @relation("SupportRequester")
  assignedSupportTickets SupportTicket[] @relation("SupportAssignee")
  supportMessages SupportMessage[]
}
model AcademicYear {
  id String @id @default(cuid())
  year Int
  jec Boolean?
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  courses Course[]
  plannings Planning[]
  assessments Assessment[]
  supportMaterials SupportMaterial[]
  hcOfferings HCCurricularOffering[]
  @@unique([schoolId,year])
}
model Course {
  id String @id @default(cuid())
  name String
  level String
  track Track
  schoolId String
  academicYearId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade)
  plannings Planning[]
  assessments Assessment[]
  supportMaterials SupportMaterial[]
  teachingAssignments TeachingAssignment[]
  hcTeachingAssignments HCTeachingAssignment[]
  agendaTasks AgendaTask[]
  @@index([schoolId,academicYearId])
}
model LearningObjective {
  id String @id @default(cuid())
  code String
  text String
  level String
  subject String?
  specialty String?
  module String?
  source String
  sourceUrl String?
  planningLinks PlanningObjective[]
  assessmentLinks AssessmentObjective[]
  moduleLinks CurriculumModuleObjective[]
  unitLinks CurriculumUnitObjective[]
  moduleUnitLinks CurriculumModuleUnitObjective[]
  @@index([level,subject])
  @@index([specialty,module])
}
model Planning {
  id String @id @default(cuid())
  title String
  status PlanningStatus @default(DRAFT)
  track Track
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  objectives PlanningObjective[]
  implementation ImplementationRecord?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PlanningObjective {
  planningId String
  objectiveId String
  planning Planning @relation(fields:[planningId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id])
  @@id([planningId,objectiveId])
}
model ImplementationRecord {
  id String @id @default(cuid())
  planningId String @unique
  implementedAt DateTime
  evidence String?
  notes String?
  planning Planning @relation(fields:[planningId],references:[id],onDelete:Cascade)
}
model Assessment {
  id String @id @default(cuid())
  title String
  type AssessmentType
  track Track
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  objectives AssessmentObjective[]
  result AssessmentResult?
  createdAt DateTime @default(now())
}
model AssessmentObjective {
  assessmentId String
  objectiveId String
  assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id])
  @@id([assessmentId,objectiveId])
}
model AssessmentResult {
  id String @id @default(cuid())
  assessmentId String @unique
  achievement Float
  students Int?
  notes String?
  assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade)
}

model TeachingAssignment {
  id String @id @default(cuid())
  subject String
  courseId String
  teacherId String
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  teacher User @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([courseId,subject,teacherId])
  @@index([teacherId])
}

model HCCurricularOffering {
  id String @id @default(cuid())
  name String
  area String?
  level String
  source OfferingSource @default(MINEDUC)
  officialCode String?
  weeklyHours Int?
  active Boolean @default(true)
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  teachingAssignments HCTeachingAssignment[]
  @@unique([academicYearId,level,name])
  @@index([academicYearId,level,active])
}

model HCTeachingAssignment {
  id String @id @default(cuid())
  offeringId String
  courseId String
  teacherId String
  offering HCCurricularOffering @relation(fields:[offeringId],references:[id],onDelete:Cascade)
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  teacher User @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([offeringId,courseId,teacherId])
  @@index([courseId])
  @@index([teacherId])
}


model CurriculumUnit {
  id String @id @default(cuid())
  level String
  subject String
  number Int
  title String
  purpose String?
  source String
  sourceUrl String?
  active Boolean @default(true)
  objectives CurriculumUnitObjective[]
  @@unique([level,subject,number])
  @@index([level,subject,active])
}
model CurriculumUnitObjective {
  unitId String
  objectiveId String
  unit CurriculumUnit @relation(fields:[unitId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id],onDelete:Cascade)
  @@id([unitId,objectiveId])
  @@index([objectiveId])
}

model CurriculumModule {
  id String @id @default(cuid())
  code String?
  name String
  specialty String
  level String
  source String
  sourceUrl String?
  active Boolean @default(true)
  objectives CurriculumModuleObjective[]
  units CurriculumModuleUnit[]
  @@unique([specialty,level,name])
  @@index([specialty,level])
}

model CurriculumModuleObjective {
  moduleId String
  objectiveId String
  module CurriculumModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id],onDelete:Cascade)
  @@id([moduleId,objectiveId])
  @@index([objectiveId])
}

model CurriculumModuleUnit {
  id String @id @default(cuid())
  moduleId String
  number Int
  title String
  source String
  sourceUrl String?
  active Boolean @default(true)
  module CurriculumModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
  objectives CurriculumModuleUnitObjective[]
  @@unique([moduleId,number])
  @@index([moduleId,active])
}
model CurriculumModuleUnitObjective {
  unitId String
  objectiveId String
  unit CurriculumModuleUnit @relation(fields:[unitId],references:[id],onDelete:Cascade)
  objective LearningObjective @relation(fields:[objectiveId],references:[id],onDelete:Cascade)
  @@id([unitId,objectiveId])
  @@index([objectiveId])
}

model SupportMaterial {
  id String @id @default(cuid())
  title String
  materialType String
  subject String?
  topic String
  content Json
  userId String
  courseId String
  academicYearId String
  user User @relation(fields:[userId],references:[id])
  course Course @relation(fields:[courseId],references:[id])
  academicYear AcademicYear @relation(fields:[academicYearId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([courseId])
}

model SubscriptionPayment {
  id String @id @default(cuid())
  commerceOrder String @unique
  flowToken String? @unique
  flowOrder Int?
  userId String
  amount Int
  status String @default("PENDING")
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
}

model AgendaTask {
  id String @id @default(cuid())
  title String
  kind String
  scheduledAt DateTime
  completed Boolean @default(false)
  notes String?
  userId String
  courseId String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  course Course? @relation(fields:[courseId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,scheduledAt])
}

model SubscriptionReminder {
  id String @id @default(cuid())
  userId String
  subscriptionEndsAt DateTime
  daysBefore Int
  sentAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,subscriptionEndsAt,daysBefore])
  @@index([subscriptionEndsAt,daysBefore])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}
enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
model SupportTicket {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  category String
  subject String
  detail String
  status SupportTicketStatus @default(OPEN)
  priority SupportTicketPriority @default(NORMAL)
  requesterId String
  assigneeId String?
  requester User @relation("SupportRequester",fields:[requesterId],references:[id],onDelete:Cascade)
  assignee User? @relation("SupportAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  messages SupportMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  @@index([requesterId,status])
  @@index([status,updatedAt])
}
model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  authorId String
  body String
  internal Boolean @default(false)
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([ticketId,createdAt])
}

model PortfolioDraft {
  id String @id @default(cuid())
  userId String
  year Int @default(2026)
  grouping String
  module Int
  section Int
  content String @db.Text
  rubric String @default("") @db.Text
  reviewed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,year,grouping,module,section])
  @@index([userId,year])
}

model PortfolioReview {
  id String @id @default(cuid())
  userId String
  year Int @default(2026)
  grouping String
  module Int
  section Int
  result Json
  evidenceSnapshot String @db.Text
  indicatorSnapshot String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,year,grouping,module,section])
  @@index([userId,year])
}

model LearningResource {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  moduleId String
  grade String
  title String
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,updatedAt])
}

/** Progreso persistente de generación privada PAES 65; sin datos personales. */
model PaesInternalJob {
  aiChargedAt DateTime?
  id String @id @default(cuid())
  userId String?
  status String @default("PENDING")
  difficulty String
  nextPart Int @default(0)
  texts Json @default("[]")
  items Json @default("[]")
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,updatedAt])
}

/** Ensayos PAES guardados en la carpeta personal del usuario. */
model SavedPaesExam {
  id String @id @default(cuid())
  userId String
  sourceJobId String
  title String
  examType String
  exam Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId,sourceJobId])
  @@index([userId,createdAt])
}

model YanayCommercialLead {
  id String @id @default(cuid())
  name String
  institution String?
  role String?
  phone String
  email String
  product String
  preferredTime String?
  notes String? @db.Text
  consentAt DateTime
  status String @default("NUEVO")
  confirmedMeetingAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([email,createdAt])
}

model EcepExam {
 planSnapshot Json @default("[]")
 id String @id @default(cuid())
 userId String
 title String
 level String
 specialtyKey String
 quantity Int
 difficulty String
 domain Int @default(-1)
 status String @default("PENDING")
 nextIndex Int @default(0)
 questions Json @default("[]")
 leaseToken String?
 aiChargedAt DateTime?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId,status,createdAt])
}


model InstitutionalExamLicense {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  product String
  grade String
  subject String
  studentCount Int
  netPricePerStudent Int @default(6100)
  pdfLimit Int @default(10)
  pdfUsed Int @default(0)
  reviewLimit Int
  reviewsUsed Int @default(0)
  startsAt DateTime
  expiresAt DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,product,grade,subject])
  @@index([active,expiresAt])
}

model LicensedStudent {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  firstName String
  paternalSurname String
  maternalSurname String
  rut String
  course String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academicExamResults AcademicExamResult[]
  @@unique([schoolId,rut])
  @@index([schoolId,course])
}

model YanayGoogleCalendarConnection {
  id String @id
  email String
  refreshTokenEncrypted String @db.Text
  updatedAt DateTime @updatedAt
}

model AcademicExamResult {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student LicensedStudent @relation(fields:[studentId],references:[id],onDelete:Cascade)
  product String
  subject String
  grade String
  course String
  examId String
  examTitle String
  takenAt DateTime
  correctAnswers Int
  totalQuestions Int
  score Float?
  skillResults Json?
  contentResults Json?
  achievementLevel String?
  levelMethod String?
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,studentId,product,examId])
  @@index([schoolId,course,subject,takenAt])
  @@index([studentId,takenAt])
}

model RegistrationIpBlock {
  id String @id @default(cuid())
  ipHash String @unique
  reason String
  expiresAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model CommercialLeadActivity {
 id String @id @default(cuid())
 userId String
 adminId String
 status String
 note String?
 doNotContact Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}

model CommercialEmailCampaign {
 id String @id @default(cuid())
 name String
 subject String
 body String @db.Text
 enabled Boolean @default(false)
 createdById String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model CommercialEmailDelivery {
 id String @id @default(cuid())
 campaignId String
 userId String
 status String @default("PENDING")
 sentAt DateTime?
 error String?
 createdAt DateTime @default(now())
 @@unique([campaignId,userId])
 @@index([status,createdAt])
}
model CommercialEmailConsent {
 userId String @id
 optedIn Boolean @default(false)
 updatedAt DateTime @updatedAt
}

model SharedLibraryResource {
  id String @id @default(cuid())
  authorId String
  sourceId String?
  title String
  kind String
  subject String?
  level String?
  objective String?
  description String?
  content Json
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,kind,createdAt])
  @@index([authorId,createdAt])
  @@unique([authorId,kind,sourceId])
}

// Acceso explícito por módulo pedagógico; las licencias de ensayos no conceden acceso.
model PedagogicalModuleLicense {
  id String @id @default(cuid())
  schoolId String
  module String
  active Boolean @default(true)
  startsAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([schoolId,module,active,expiresAt])
}
